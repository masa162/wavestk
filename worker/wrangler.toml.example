name = "wavestk-worker"
main = "src/index.ts"
compatibility_date = "2024-11-21"
# account_id = "<YOUR_ACCOUNT_ID>"  # Optional: Set via wrangler login or CLOUDFLARE_ACCOUNT_ID env var

# R2 Bucket Binding
[[r2_buckets]]
binding = "R2_BUCKET"
bucket_name = "wavestk-audio"

# Custom Domain (set via Cloudflare Dashboard)
# wave.be2nd.com
